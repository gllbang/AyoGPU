 logger = get_logger(__name__, level=GLOBAL_INFO_LEVEL)
 
 
+async def collect_fifo(engine, size):
+    """Optional bounded batching; preserve requests and overflow order."""
+    pending = getattr(engine, "benchmark_pending", None)
+    first = pending if pending is not None else await engine.request_queue.get()
+    engine.benchmark_pending = None
+    batch, used = [first], size(first)
+    deadline = time.perf_counter() + engine.benchmark_batch_wait_s
+    while used < engine.max_batch_size:
+        if not engine.request_queue.empty():
+            request = engine.request_queue.get_nowait()
+        else:
+            remaining = deadline - time.perf_counter()
+            if remaining <= 0:
+                break
+            try:
+                request = await asyncio.wait_for(engine.request_queue.get(), remaining)
+            except asyncio.TimeoutError:
+                break
+        if used + size(request) > engine.max_batch_size:
+            engine.benchmark_pending = request
+            break
+        batch.append(request)
+        used += size(request)
+    return batch
+
